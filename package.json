{
  "name": "@app-ready/workspace",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "ISC",
  "keywords": [
    "react",
    "workspace"
  ],
  "description": "app ready",
  "workspaces": [
    "apps\\libs",
    "apps\\mobile",
    "apps\\react-single-plugin",
    "apps\\react-scope-css-plugin",
    "apps\\res-to-dts-plugin"
  ],
  "scripts": {
    "start": "npm run dev -w=@app-ready/mobile",
    "build:dev": "npm run build:dev -w=@app-ready/mobile",
    "build:test": "npm run build:test -w=@app-ready/mobile",
    "build:prod": "npm run build:prod -w=@app-ready/mobile",
    "lint": "eslint apps/*/src/**/*.{ts,tsx} --color --fix",
    "styleLint": "stylelint apps/*/src/**/*.{scss,css} --color",
    "prepare": "husky init",
    "commit": "cz",
    "update": "ncu -u -ws --root && npm i --include-workspace-root --workspaces"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@eslint/js": "^9.14.0",
    "@hookform/error-message": "^2.0.1",
    "ahooks": "^3.8.1",
    "antd": "^5.22.1",
    "axios": "^1.7.7",
    "classnames": "^2.5.1",
    "framer-motion": "^10.18.0",
    "lodash-es": "^4.17.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-router-dom": "^6.28.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "urijs": "^1.19.11",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@snipaste-cli/core": "^0.0.6",
    "@tsconfig/vite-react": "^3.0.2",
    "@types/eslint__js": "^8.42.3",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/urijs": "^1.19.25",
    "@vitejs/plugin-react": "^4.3.3",
    "commitizen": "^4.3.1",
    "eslint": "^9.14.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "npm-check-updates": "^17.1.11",
    "postcss-pxtorem": "^6.1.0",
    "postcss-scss": "^4.0.9",
    "stylelint": "^16.10.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.11",
    "vite-plugin-inspect": "^0.8.7"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}